  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "sandbox",
    "security",
    "guard",
    "permission",
    "delegation",
    "tool-filter",
    "persona"
  ],
  "license": "MIT",
  "author": "NightPainters",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "./lib/index.js",
    "./lib/rules.js",
    "./lib/policy.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "tests",
    "docs",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NightPainters/dsh-subagent-guard.git"
  },
  "homepage": "https://github.com/NightPainters/dsh-subagent-guard#readme",
  "bugs": {
    "url": "https://github.com/NightPainters/dsh-subagent-guard/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "test": "node tests/guard.test.mjs && node tests/policy.test.mjs && node tests/apply.test.mjs && node tests/delegate.test.mjs && node tests/regressions.test.mjs && node tests/audit-20261028.test.mjs",
    "test:rules": "node tests/guard.test.mjs",
    "test:policy": "node tests/policy.test.mjs",
    "test:apply": "node tests/apply.test.mjs",
    "test:delegate": "node tests/delegate.test.mjs",
    "test:regressions": "node tests/regressions.test.mjs",
    "test:audit": "node tests/audit-20261028.test.mjs"
